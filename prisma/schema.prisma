generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  image       String?
  category    String   @default("produit")
  featured    Boolean  @default(false)
  stock       Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PtcUser {
  id            String    @id @default(cuid())
  phone         String    @unique
  balance       Int       @default(0)
  totalViewed   Int       @default(0)
  referralCode  String    @unique @default(cuid())
  referredBy    String?
  parrain       PtcUser?  @relation("Referrals", fields: [referredBy], references: [referralCode])
  referralCount Int       @default(0)
  referralEarnings Int    @default(0)
  views         PtcView[]
  referrals     PtcUser[] @relation("Referrals")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PtcView {
  id        String   @id @default(cuid())
  userId    String
  user      PtcUser  @relation(fields: [userId], references: [id])
  earned    Int      @default(1)
  createdAt DateTime @default(now())
}